@{
    ViewData["Title"] = "Registrar entrega";
    var requestId = ViewData["RequestId"]?.ToString() ?? string.Empty;
}

<section class="container py-4" id="request-delivery-page" data-request-id="@requestId" aria-labelledby="request-delivery-title">
    <div class="mb-4">
        <a class="btn btn-sm btn-outline-secondary mb-2" href="/requests">Voltar às solicitações</a>
        <p class="text-uppercase text-secondary fw-semibold mb-2">Operação</p>
        <h1 id="request-delivery-title" class="h2">Registrar entrega</h1>
        <p class="text-secondary mb-0">Confirme quem recebeu e capture a assinatura. A API consome a reserva e registra o protocolo atomicamente.</p>
    </div>

    <div class="card card-body mb-4">
        <h2 class="h5">Acesso</h2>
        <form id="request-delivery-login" novalidate>
            <div class="row g-3 align-items-end">
                <div class="col-md-5"><label class="form-label" for="request-delivery-email">E-mail</label><input class="form-control" id="request-delivery-email" type="email" autocomplete="username" required /></div>
                <div class="col-md-5"><label class="form-label" for="request-delivery-password">Senha</label><input class="form-control" id="request-delivery-password" type="password" autocomplete="current-password" required /></div>
                <div class="col-md-2 d-grid"><button class="btn btn-primary" id="request-delivery-login-button" type="submit">Entrar</button></div>
            </div>
        </form>
        <div id="request-delivery-session" class="mt-3 d-none"><span id="request-delivery-user"></span><button class="btn btn-sm btn-outline-secondary ms-2" id="request-delivery-logout" type="button">Sair</button></div>
    </div>

    <p id="request-delivery-message" class="small" role="status" aria-live="polite"></p>
    <div id="request-delivery-error" class="alert alert-danger d-none" role="alert"></div>
    <div id="request-delivery-capability" class="alert alert-warning d-none" role="status"></div>

    <section id="request-delivery-content" class="d-none">
        <div id="request-delivery-request" class="card card-body mb-4">
            <h2 class="h5" id="request-delivery-code"></h2>
            <p id="request-delivery-purpose" class="mb-3"></p>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Brinde</th><th>Quantidade para entrega</th></tr></thead>
                    <tbody id="request-delivery-items"></tbody>
                </table>
            </div>
        </div>

        <form id="request-delivery-form" class="card card-body d-none" novalidate>
            <h2 class="h5">Recebedor</h2>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label" for="delivery-received-name">Nome de quem recebeu <span aria-hidden="true">*</span></label><input class="form-control" id="delivery-received-name" maxlength="150" required /></div>
                <div class="col-md-6"><label class="form-label" for="delivery-received-email">E-mail</label><input class="form-control" id="delivery-received-email" type="email" maxlength="190" /></div>
                <div class="col-md-6"><label class="form-label" for="delivery-received-document">Documento</label><input class="form-control" id="delivery-received-document" maxlength="30" /></div>
                <div class="col-md-6"><label class="form-label" for="delivery-received-phone">Telefone</label><input class="form-control" id="delivery-received-phone" maxlength="30" /></div>
                <div class="col-12"><label class="form-label" for="delivery-notes">Observações</label><textarea class="form-control" id="delivery-notes" rows="3" maxlength="1000"></textarea></div>
                <div class="col-12">
                    <label class="form-label" for="delivery-signature">Assinatura de quem recebeu <span aria-hidden="true">*</span></label>
                    <p id="delivery-signature-help" class="small text-secondary">Assine com mouse, caneta ou toque. A imagem será enviada somente à API e armazenada em área privada.</p>
                    <canvas id="delivery-signature" class="border rounded w-100" width="1200" height="360" aria-label="Campo para assinatura de quem recebeu" aria-describedby="delivery-signature-help" style="aspect-ratio: 10 / 3; touch-action: none; background: #fff;"></canvas>
                    <button class="btn btn-sm btn-outline-secondary mt-2" id="delivery-signature-clear" type="button">Limpar assinatura</button>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-4">
                <button class="btn btn-primary" id="request-delivery-confirm" type="submit">Confirmar entrega e gerar protocolo</button>
                <a class="btn btn-outline-secondary" href="/requests">Cancelar e voltar</a>
            </div>
        </form>

        <div id="request-delivery-complete" class="card card-body d-none" role="status">
            <div class="alert alert-success mb-3">Entrega registrada. Protocolo <strong id="request-delivery-protocol"></strong>.</div>
            <a id="request-delivery-pdf" class="btn btn-primary d-none" href="#" download>Baixar PDF do protocolo</a>
            <p id="request-delivery-pdf-message" class="small text-secondary mt-2 mb-0"></p>
            <a class="btn btn-outline-secondary mt-3 align-self-start" href="/requests">Voltar às solicitações</a>
        </div>
    </section>
</section>

@section Scripts {
    <script src="~/js/request-delivery.js" asp-append-version="true" defer></script>
}
