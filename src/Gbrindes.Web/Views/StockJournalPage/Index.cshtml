@{
    ViewData["Title"] = "Livro de movimentações";
}

<section class="container py-4" id="stock-journal-page" aria-labelledby="stock-journal-title">
    <p class="text-uppercase text-secondary fw-semibold mb-2">Estoque</p>
    <h1 id="stock-journal-title" class="h2">Livro de movimentações</h1>
    <p class="text-secondary">Consulte entradas, saídas, ajustes, transferências e estornos registrados no ledger. O histórico respeita o escopo de indústria aplicado pela API.</p>
    <div class="alert alert-info" role="note">Esta consulta exige <code>stock.view</code>. A API aplica o escopo de indústria do usuário independentemente dos filtros informados.</div>
    <div class="alert alert-info" role="note">A consulta do ledger é somente de leitura. A conciliação é uma ação separada, exige <code>stock.adjust</code> e só cria registros ausentes. Notas anexadas ficam em storage privado e só podem ser baixadas por usuários autorizados dentro do escopo de indústria aplicado pela API.</div>

    <div class="card card-body mb-4">
        <h2 class="h5">Acesso</h2>
        <form id="stock-journal-login-form" novalidate>
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label" for="stock-journal-email">E-mail</label>
                    <input class="form-control" id="stock-journal-email" name="email" type="email" autocomplete="username" required />
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="stock-journal-password">Senha</label>
                    <input class="form-control" id="stock-journal-password" name="password" type="password" autocomplete="current-password" required />
                </div>
                <div class="col-md-2 d-grid">
                    <button class="btn btn-primary" id="stock-journal-login" type="submit">Entrar</button>
                </div>
            </div>
        </form>
        <div id="stock-journal-session" class="mt-3 d-none">
            <span id="stock-journal-user-label"></span>
            <button class="btn btn-sm btn-outline-secondary ms-2" id="stock-journal-logout" type="button">Sair</button>
        </div>
    </div>

    <p id="stock-journal-message" class="small" role="status" aria-live="polite"></p>
    <div id="stock-journal-results" class="d-none">
        <div id="stock-journal-reconcile-panel" class="d-none alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2" role="region" aria-label="Reconciliação de estoque">
            <span>Reconciliação cria somente movimentos de saldo inicial ou posições que estejam ausentes; não altera o saldo atual.</span>
            <button class="btn btn-sm btn-outline-dark" id="stock-journal-reconcile" type="button">Conciliar estoque</button>
        </div>
        <form id="stock-journal-filters" class="card card-body mb-3">
            <div class="row g-3 align-items-end">
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label" for="stock-journal-type">Tipo</label>
                    <select class="form-select" id="stock-journal-type" name="type">
                        <option value="">Todos os tipos</option>
                        <option value="entrada">Entrada</option>
                        <option value="saida">Saída</option>
                        <option value="ajuste">Ajuste</option>
                        <option value="transferencia">Transferência</option>
                        <option value="estorno">Estorno</option>
                    </select>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label" for="stock-journal-query">Busca</label>
                    <input class="form-control" id="stock-journal-query" name="q" type="search" maxlength="100" placeholder="Código, brinde ou finalidade" />
                </div>
                <div class="col-sm-6 col-lg-2">
                    <label class="form-label" for="stock-journal-from">De</label>
                    <input class="form-control" id="stock-journal-from" name="from" type="date" />
                </div>
                <div class="col-sm-6 col-lg-2">
                    <label class="form-label" for="stock-journal-to">Até</label>
                    <input class="form-control" id="stock-journal-to" name="to" type="date" />
                </div>
                <div class="col-lg-2 d-grid">
                    <button class="btn btn-primary" id="stock-journal-search" type="submit">Filtrar</button>
                </div>
            </div>
        </form>

        <div class="table-responsive bg-white rounded border mb-3">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Data / hora</th>
                        <th scope="col">Tipo</th>
                        <th scope="col">Brinde</th>
                        <th scope="col" class="text-end">Quantidade</th>
                        <th scope="col" class="text-end">Saldo após</th>
                        <th scope="col">Responsável</th>
                        <th scope="col">Detalhes</th>
                        <th scope="col">Valor / NF</th>
                    </tr>
                </thead>
                <tbody id="stock-journal-rows"></tbody>
            </table>
        </div>
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <button class="btn btn-sm btn-outline-secondary" id="stock-journal-previous" type="button" disabled>Anterior</button>
            <span id="stock-journal-page-label" class="small text-secondary" aria-live="polite"></span>
            <button class="btn btn-sm btn-outline-secondary" id="stock-journal-next" type="button" disabled>Próxima</button>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/stock-journal.js" asp-append-version="true" defer></script>
}
