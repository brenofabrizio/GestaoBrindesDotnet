@{
    ViewData["Title"] = "Notificações";
}

<section class="container py-4" id="notifications-page" aria-labelledby="notifications-title">
    <p class="text-uppercase text-secondary fw-semibold mb-2">Operação</p>
    <h1 id="notifications-title" class="h2">Notificações</h1>
    <p class="text-secondary">Veja atualizações e pendências relacionadas à sua operação.</p>

    <div class="card card-body mb-4">
        <h2 class="h5">Acesso</h2>
        <form id="notifications-login-form" novalidate>
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label" for="notifications-email">E-mail</label>
                    <input class="form-control" id="notifications-email" type="email" autocomplete="username" required />
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="notifications-password">Senha</label>
                    <input class="form-control" id="notifications-password" type="password" autocomplete="current-password" required />
                </div>
                <div class="col-md-2 d-grid">
                    <button class="btn btn-primary" id="notifications-login" type="submit">Entrar</button>
                </div>
            </div>
        </form>
        <div id="notifications-session" class="mt-3 d-none">
            <span id="notifications-user-label"></span>
            <button class="btn btn-sm btn-outline-secondary ms-2" id="notifications-logout" type="button">Sair</button>
        </div>
    </div>

    <p id="notifications-message" class="small" role="status" aria-live="polite"></p>
    <section id="notifications-results" class="d-none" aria-label="Caixa de notificações">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h4 mb-0">Atualizações</h2>
            <div class="d-flex gap-2">
                <label class="form-check d-flex align-items-center gap-2 mb-0">
                    <input id="notifications-unread" class="form-check-input" type="checkbox" />
                    <span>Somente não lidas</span>
                </label>
                <button class="btn btn-sm btn-outline-secondary" id="notifications-read-all" type="button">Marcar todas como lidas</button>
                <button class="btn btn-sm btn-outline-primary" id="notifications-refresh" type="button">Atualizar</button>
            </div>
        </div>
        <div id="notifications-list" class="vstack gap-2"></div>
        <nav id="notifications-pagination" class="mt-3" aria-label="Paginação de notificações"></nav>
    </section>
</section>

@section Scripts {
    <script src="~/js/notifications.js" asp-append-version="true" defer></script>
}
