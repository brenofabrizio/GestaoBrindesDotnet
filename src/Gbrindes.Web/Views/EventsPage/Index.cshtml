@{
    ViewData["Title"] = "Eventos e feirões";
}

<section class="container py-4" id="events-page" aria-labelledby="events-title">
    <p class="text-uppercase text-secondary fw-semibold mb-2">Operação</p>
    <h1 id="events-title" class="h2">Eventos e feirões</h1>
    <p class="text-secondary">Consulte eventos e crie eventos planejados. A API valida as permissões e o escopo em cada operação.</p>
    <div class="card card-body mb-4">
        <h2 class="h5">Acesso</h2>
        <form id="events-login-form" novalidate>
            <div class="row g-3 align-items-end">
                <div class="col-md-5"><label class="form-label" for="events-email">E-mail</label><input class="form-control" id="events-email" type="email" autocomplete="username" required /></div>
                <div class="col-md-5"><label class="form-label" for="events-password">Senha</label><input class="form-control" id="events-password" type="password" autocomplete="current-password" required /></div>
                <div class="col-md-2 d-grid"><button class="btn btn-primary" id="events-login" type="submit">Entrar</button></div>
            </div>
        </form>
        <div id="events-session" class="mt-3 d-none"><span id="events-user-label"></span><button class="btn btn-sm btn-outline-secondary ms-2" id="events-logout" type="button">Sair</button></div>
    </div>
    <p id="events-message" class="small" role="status" aria-live="polite"></p>
    <section id="events-results" class="d-none" aria-label="Eventos">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h4 mb-0">Eventos cadastrados</h2>
            <div class="d-flex gap-2"><input id="events-search" class="form-control" type="search" placeholder="Buscar evento" aria-label="Buscar evento" /><button id="events-refresh" class="btn btn-outline-primary" type="button">Atualizar</button></div>
        </div>
        <form id="events-create-form" class="card card-body mb-4">
            <h3 class="h5">Novo evento</h3>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label" for="event-name">Nome</label><input id="event-name" class="form-control" maxlength="150" required /></div>
                <div class="col-md-6"><label class="form-label" for="event-venue">Local</label><input id="event-venue" class="form-control" maxlength="190" /></div>
                <div class="col-md-6"><label class="form-label" for="event-start">Data inicial</label><input id="event-start" class="form-control" type="date" /></div>
                <div class="col-md-6"><label class="form-label" for="event-end">Data final</label><input id="event-end" class="form-control" type="date" /></div>
                <div class="col-12"><label class="form-label" for="event-description">Descrição</label><textarea id="event-description" class="form-control" maxlength="4000" rows="2"></textarea></div>
                <div class="col-12"><button class="btn btn-primary" id="events-create" type="submit">Criar evento planejado</button></div>
            </div>
        </form>
        <div id="events-list" class="row g-3"></div>
    </section>
</section>

@section Scripts {
    <script src="~/js/events.js" asp-append-version="true" defer></script>
}
