@{
    ViewData["Title"] = "Alteração de senha";
}

<section class="container py-4" id="account-password-page" aria-labelledby="account-password-title">
    <p class="text-uppercase text-secondary fw-semibold mb-2">Conta</p>
    <h1 id="account-password-title" class="h2">Alteração de senha</h1>
    <p class="text-secondary">Entre para alterar sua senha. Contas com troca obrigatória precisam concluir este passo antes de usar as áreas protegidas.</p>

    <div class="card card-body mb-4">
        <h2 class="h5">Acesso</h2>
        <form id="account-password-login-form" novalidate>
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label" for="account-password-email">E-mail</label>
                    <input class="form-control" id="account-password-email" type="email" autocomplete="username" required />
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="account-password-login-password">Senha atual</label>
                    <input class="form-control" id="account-password-login-password" type="password" autocomplete="current-password" required />
                </div>
                <div class="col-md-2 d-grid">
                    <button class="btn btn-primary" id="account-password-login-button" type="submit">Entrar</button>
                </div>
            </div>
        </form>
        <div id="account-password-session" class="mt-3 d-none">
            <span id="account-password-user-label"></span>
            <button class="btn btn-sm btn-outline-secondary ms-2" id="account-password-logout" type="button">Sair</button>
        </div>
    </div>

    <p id="account-password-message" class="small" role="status" aria-live="polite"></p>
    <section id="account-password-change-panel" class="card card-body d-none" aria-labelledby="account-password-change-title">
        <h2 id="account-password-change-title" class="h4">Defina sua nova senha</h2>
        <p class="text-secondary">Use pelo menos 8 caracteres e inclua um número. A senha atual é solicitada novamente para confirmar a alteração.</p>
        <form id="account-password-change-form" novalidate>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="account-password-current-password">Senha atual</label>
                    <input class="form-control" id="account-password-current-password" type="password" autocomplete="current-password" maxlength="256" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="account-password-new-password">Nova senha</label>
                    <input class="form-control" id="account-password-new-password" type="password" autocomplete="new-password" minlength="8" maxlength="256" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="account-password-confirm-password">Confirme a nova senha</label>
                    <input class="form-control" id="account-password-confirm-password" type="password" autocomplete="new-password" minlength="8" maxlength="256" required />
                </div>
                <div class="col-12">
                    <button class="btn btn-primary" id="account-password-change-button" type="submit">Alterar senha</button>
                </div>
            </div>
        </form>
    </section>
</section>

@section Scripts {
    <script src="~/js/account-password.js" asp-append-version="true" defer></script>
}
