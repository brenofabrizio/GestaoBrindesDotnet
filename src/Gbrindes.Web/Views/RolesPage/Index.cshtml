@{
    ViewData["Title"] = "Perfis e permissões";
}

<section class="container py-4" id="roles-page" aria-labelledby="roles-title">
    <p class="text-uppercase text-secondary fw-semibold mb-2">Administração</p>
    <h1 id="roles-title" class="h2">Perfis e permissões</h1>
    <p class="text-secondary">Edite somente os grants explícitos do ambiente .NET. Esta tela não importa nem combina matrizes PHP/Laravel.</p>
    <div class="alert alert-warning" role="note">Nenhuma permissão será atribuída automaticamente. Homologue os grants de negócio antes de salvar alterações.</div>

    <div class="card card-body mb-4">
        <h2 class="h5">Acesso</h2>
        <form id="roles-login-form" novalidate>
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label" for="roles-email">E-mail</label>
                    <input class="form-control" id="roles-email" name="email" type="email" autocomplete="username" required />
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="roles-password">Senha</label>
                    <input class="form-control" id="roles-password" name="password" type="password" autocomplete="current-password" required />
                </div>
                <div class="col-md-2 d-grid">
                    <button class="btn btn-primary" id="roles-login" type="submit">Entrar</button>
                </div>
            </div>
        </form>
        <div id="roles-session" class="mt-3 d-none">
            <span id="roles-user-label"></span>
            <button class="btn btn-sm btn-outline-secondary ms-2" id="roles-logout" type="button">Sair</button>
        </div>
    </div>

    <p id="roles-message" class="small" role="status" aria-live="polite"></p>
    <section id="role-list" class="d-none" aria-label="Perfis existentes"></section>
</section>

@section Scripts {
    <script src="~/js/roles.js" asp-append-version="true" defer></script>
}
