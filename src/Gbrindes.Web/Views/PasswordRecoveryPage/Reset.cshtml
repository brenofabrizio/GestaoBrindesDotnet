@{
    Layout = null;
}
<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Nova senha — Emefarma</title><link rel="icon" type="image/png" href="~/assets/img/Emefarma_Símbolo_Azul Claro.png"><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"><link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css"><link rel="stylesheet" href="~/css/site.css"><link rel="stylesheet" href="~/css/auth.css"></head><body><main class="auth-wrap"><section class="auth-login-shell fade-in" aria-labelledby="reset-title"><div class="auth-login-card"><div class="auth-login-brand"><span class="auth-login-logo"><img src="~/assets/img/Emefarma_Símbolo_Azul Claro.png" alt="Logo Emefarma"></span><span class="auth-login-company">Emefarma</span></div><div class="auth-card-header"><span class="auth-kicker">CONTROLE DE BRINDES</span><h1 id="reset-title">Crie uma nova senha</h1><p>Escolha uma senha com pelo menos 8 caracteres e um número.</p></div><form id="reset-password-form" class="auth-form" novalidate><label class="form-label" for="reset-password">Nova senha</label><input class="form-control mb-3" id="reset-password" type="password" minlength="8" autocomplete="new-password" required><label class="form-label" for="reset-password-confirmation">Confirme a nova senha</label><input class="form-control mb-3" id="reset-password-confirmation" type="password" minlength="8" autocomplete="new-password" required><p id="reset-message" class="small" role="status" aria-live="polite"></p><button class="btn btn-primary auth-submit w-100" type="submit" id="reset-submit"><span>Redefinir senha</span><i class="bi bi-check2" aria-hidden="true"></i></button></form><a class="auth-forgot d-inline-block mt-3" href="~/login">Voltar para o login</a></div><p class="auth-login-footer">© @DateTime.UtcNow.Year Emefarma <span aria-hidden="true">·</span> Gestão de brindes</p></section></main><script src="~/js/password-recovery.js"></script></body></html>
