@{
    Layout = null;
}
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Esqueci minha senha — Emefarma</title>
<link rel="icon" type="image/png" href="~/assets/img/Emefarma_Símbolo_Azul Claro.png">
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"><link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css"><link rel="stylesheet" href="~/css/site.css"><link rel="stylesheet" href="~/css/auth.css">
</head>
<body><main class="auth-wrap"><section class="auth-login-shell fade-in" aria-labelledby="forgot-title"><div class="auth-login-card"><div class="auth-login-brand"><span class="auth-login-logo"><img src="~/assets/img/Emefarma_Símbolo_Azul Claro.png" alt="Logo Emefarma"></span><span class="auth-login-company">Emefarma</span></div><div class="auth-card-header"><span class="auth-kicker">CONTROLE DE BRINDES</span><h1 id="forgot-title">Redefinir sua senha</h1><p>Informe seu e-mail corporativo e enviaremos as instruções.</p></div><form id="forgot-password-form" class="auth-form" novalidate><label class="form-label" for="forgot-email">E-mail</label><div class="auth-input-wrap mb-3"><i class="bi bi-envelope" aria-hidden="true"></i><input class="form-control" id="forgot-email" type="email" autocomplete="email" required placeholder="seu@email.com"></div><p id="forgot-message" class="small" role="status" aria-live="polite"></p><button class="btn btn-primary auth-submit w-100" type="submit" id="forgot-submit"><span>Enviar instruções</span><i class="bi bi-arrow-right" aria-hidden="true"></i></button></form><a class="auth-forgot d-inline-block mt-3" href="~/login">Voltar para o login</a></div><p class="auth-login-footer">© @DateTime.UtcNow.Year Emefarma <span aria-hidden="true">·</span> Gestão de brindes</p></section></main><script src="~/js/password-recovery.js"></script></body></html>
