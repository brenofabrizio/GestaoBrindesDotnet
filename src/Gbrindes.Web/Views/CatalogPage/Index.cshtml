@{
    ViewData["Title"] = "Catálogo de brindes";
}

<section class="container py-4" id="catalog-page" aria-labelledby="catalog-title">
    <div class="row justify-content-center">
        <div class="col-12">
            <p class="text-uppercase text-secondary fw-semibold mb-2">Catálogo</p>
            <h1 id="catalog-title" class="h2">Catálogo de brindes</h1>
            <p class="text-secondary">Consulte os brindes disponíveis para a sua conta.</p>

            <div class="card card-body mb-4">
                <h2 class="h5">Acesso</h2>
                <form id="catalog-login-form" novalidate>
                    <div class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label" for="catalog-email">E-mail</label>
                            <input class="form-control" id="catalog-email" name="email" type="email" autocomplete="username" required />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" for="catalog-password">Senha</label>
                            <input class="form-control" id="catalog-password" name="password" type="password" autocomplete="current-password" required />
                        </div>
                        <div class="col-md-2 d-grid">
                            <button class="btn btn-primary" id="catalog-login" type="submit">Entrar</button>
                        </div>
                    </div>
                </form>
                <div id="catalog-session" class="mt-3 d-none">
                    <span id="catalog-user-label"></span>
                    <button class="btn btn-sm btn-outline-secondary ms-2" id="catalog-logout" type="button">Sair</button>
                </div>
            </div>

            <div id="catalog-results" class="d-none" aria-labelledby="catalog-results-title">
                <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-3">
                    <h2 id="catalog-results-title" class="h4 mb-0">Brindes</h2>
                    <form id="catalog-filters" class="d-flex flex-wrap gap-2 align-items-end">
                        <div>
                            <label class="form-label small mb-1" for="catalog-search">Buscar código ou nome</label>
                            <input class="form-control form-control-sm" id="catalog-search" type="search" autocomplete="off" />
                        </div>
                        <div>
                            <label class="form-label small mb-1" for="catalog-status">Status</label>
                            <select class="form-select form-select-sm" id="catalog-status">
                                <option value="">Todos</option>
                                <option value="ativo">Ativo</option>
                                <option value="inativo">Inativo</option>
                            </select>
                        </div>
                        <button class="btn btn-sm btn-outline-primary" id="catalog-refresh" type="submit">Buscar</button>
                    </form>
                </div>
                <p id="catalog-message" class="small" role="status" aria-live="polite"></p>
                <div id="catalog-table" class="table-responsive bg-white rounded border shadow-sm mb-3"></div>
                <div id="catalog-pagination" class="d-flex align-items-center justify-content-between gap-2">
                    <button class="btn btn-sm btn-outline-secondary" id="catalog-previous" type="button" disabled>Anterior</button>
                    <span id="catalog-page-label" class="small text-secondary" aria-live="polite"></span>
                    <button class="btn btn-sm btn-outline-secondary" id="catalog-next" type="button" disabled>Próxima</button>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/catalog.js" asp-append-version="true" defer></script>
}
