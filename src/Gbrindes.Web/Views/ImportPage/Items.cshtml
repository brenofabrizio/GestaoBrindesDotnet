@{
    ViewData["Title"] = "Importação de brindes";
}

<section class="container py-4" aria-labelledby="import-title" id="item-import-page"
         data-import-template-items="/api/v1/import/template/items"
         data-import-template-requests="/api/v1/import/template/requests"
         data-import-preview-items="/api/v1/import/items/preview"
         data-import-preview-requests="/api/v1/import/requests/preview"
         data-import-apply-items="/api/v1/import/items/apply"
         data-import-apply-requests="/api/v1/import/requests/apply">
    <div class="row justify-content-center">
        <div class="col-xl-9">
            <p class="text-uppercase text-secondary fw-semibold mb-2">Catálogo</p>
            <h1 id="import-title" class="h2">Importação de brindes</h1>
            <p class="text-secondary">Entre com uma conta autorizada, baixe o modelo e confira a prévia antes de confirmar. O arquivo não é enviado para importação até você confirmar.</p>

            <div class="card card-body mb-4">
                <h2 class="h5">Importar dados</h2>
                <p class="text-secondary mb-0">Faça uma pré-visualização antes de confirmar a importação.</p>
                <div class="mt-3">
                    <label class="form-label" for="import-type">Tipo</label>
                    <select class="form-select" id="import-type" data-import-type>
                        <option value="items">Brindes</option>
                        <option value="requests">Solicitações</option>
                    </select>
                </div>
            </div>

            <div class="card card-body mb-4">
                <form id="import-login-form" novalidate>
                    <div class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label" for="import-email">E-mail</label>
                            <input class="form-control" id="import-email" name="email" type="email" autocomplete="username" required />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" for="import-password">Senha</label>
                            <input class="form-control" id="import-password" name="password" type="password" autocomplete="current-password" required />
                        </div>
                        <div class="col-md-2 d-grid">
                            <button class="btn btn-primary" id="import-login" type="submit">Entrar</button>
                        </div>
                    </div>
                </form>
                <div id="import-session" class="mt-3 d-none">
                    <span id="import-user-label"></span>
                    <button class="btn btn-sm btn-outline-secondary ms-2" id="import-logout" type="button">Sair</button>
                </div>
            </div>

            <div id="import-workflow" class="card card-body d-none" aria-labelledby="import-workflow-title">
                <h2 id="import-workflow-title" class="h5">Planilha de brindes</h2>
                <p><button class="btn btn-link p-0" type="button" data-import-template disabled>Baixar modelo Excel (.xlsx)</button></p>
                <div class="mb-3">
                    <label class="form-label" for="import-file">Arquivo Excel</label>
                    <input class="form-control" id="import-file" name="file" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" disabled />
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-outline-primary" type="button" data-import-preview disabled>Pré-visualizar</button>
                    <button class="btn btn-primary" type="button" data-import-apply disabled>Confirmar importação</button>
                </div>
                <p class="small text-secondary mt-3 mb-0">Somente linhas válidas serão importadas. Repetir um código com dados diferentes será recusado. Quantidade inicial exige também a permissão de entrada de estoque.</p>
                <div id="import-results" class="mt-4" data-import-report aria-live="polite"></div>
            </div>

            <p id="import-message" class="mt-3" role="status" aria-live="polite"></p>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/item-import.js" asp-append-version="true" defer></script>
}
