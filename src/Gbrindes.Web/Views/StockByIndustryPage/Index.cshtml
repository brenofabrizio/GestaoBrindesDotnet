@{
    ViewData["Title"] = "Saldo por indústria e local";
}

<section class="container py-4" id="stock-by-industry-page" aria-labelledby="stock-by-industry-title">
    <p class="text-uppercase text-secondary fw-semibold mb-2">Estoque</p>
    <h1 id="stock-by-industry-title" class="h2">Saldo por indústria e local</h1>
    <p class="text-secondary">Consulte recebido, retirado e saldo por indústria e brinde; abaixo, veja onde há unidades disponíveis por local. Os valores são somente leitura e mudam por movimentações registradas.</p>
    <div class="alert alert-info" role="note">Esta consulta exige <code>stock.view</code>. O resumo por indústria respeita o escopo do usuário aplicado pela API. A posição por local segue o contrato legado e agrega as unidades disponíveis por brinde/local.</div>

    <div class="card card-body mb-4">
        <h2 class="h5">Acesso</h2>
        <form id="stock-by-industry-login-form" novalidate>
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label" for="stock-by-industry-email">E-mail</label>
                    <input class="form-control" id="stock-by-industry-email" name="email" type="email" autocomplete="username" required />
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="stock-by-industry-password">Senha</label>
                    <input class="form-control" id="stock-by-industry-password" name="password" type="password" autocomplete="current-password" required />
                </div>
                <div class="col-md-2 d-grid">
                    <button class="btn btn-primary" id="stock-by-industry-login" type="submit">Entrar</button>
                </div>
            </div>
        </form>
        <div id="stock-by-industry-session" class="mt-3 d-none">
            <span id="stock-by-industry-user-label"></span>
            <button class="btn btn-sm btn-outline-secondary ms-2" id="stock-by-industry-logout" type="button">Sair</button>
        </div>
    </div>

    <p id="stock-by-industry-message" class="small" role="status" aria-live="polite"></p>
    <div id="stock-by-industry-results" class="d-none">
        <section class="mb-4" aria-labelledby="stock-by-industry-summary-title">
            <h2 id="stock-by-industry-summary-title" class="h4">Recebido, retirado e saldo</h2>
            <div class="table-responsive bg-white rounded border">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th scope="col">Indústria</th><th scope="col">Brinde</th><th scope="col" class="text-end">Recebido</th><th scope="col" class="text-end">Retirado</th><th scope="col" class="text-end">Saldo</th></tr></thead>
                    <tbody id="stock-by-industry-rows"></tbody>
                </table>
            </div>
        </section>
        <section aria-labelledby="stock-by-industry-positions-title">
            <h2 id="stock-by-industry-positions-title" class="h4">Onde estão as unidades (CD × evento)</h2>
            <div class="table-responsive bg-white rounded border">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th scope="col">Local</th><th scope="col">Brinde</th><th scope="col" class="text-end">Quantidade</th></tr></thead>
                    <tbody id="stock-by-industry-positions"></tbody>
                </table>
            </div>
        </section>
    </div>
</section>

@section Scripts {
    <script src="~/js/stock-by-industry.js" asp-append-version="true" defer></script>
}
