@{
    ViewData["Title"] = "Confirmar saídas";
}

<section class="container py-4" id="exit-queue-page" aria-labelledby="exit-queue-title">
    <p class="text-uppercase text-secondary fw-semibold mb-2">Estoque</p>
    <h1 id="exit-queue-title" class="h2">Confirmar saídas autorizadas</h1>
    <p class="text-secondary">A equipe responsável autoriza a saída antes desta etapa. Confirmar registra a baixa no ledger e atualiza o saldo.</p>
    <div class="alert alert-info" role="note">Esta operação é exclusiva de <code>stock.exit_confirm</code>. A API valida autorização e estado da ordem; a fila não cria nem autoriza novas saídas.</div>

    <div class="card card-body mb-4">
        <h2 class="h5">Acesso</h2>
        <form id="exit-queue-login-form" novalidate>
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label" for="exit-queue-email">E-mail</label>
                    <input class="form-control" id="exit-queue-email" name="email" type="email" autocomplete="username" required />
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="exit-queue-password">Senha</label>
                    <input class="form-control" id="exit-queue-password" name="password" type="password" autocomplete="current-password" required />
                </div>
                <div class="col-md-2 d-grid">
                    <button class="btn btn-primary" id="exit-queue-login" type="submit">Entrar</button>
                </div>
            </div>
        </form>
        <div id="exit-queue-session" class="mt-3 d-none">
            <span id="exit-queue-user-label"></span>
            <button class="btn btn-sm btn-outline-secondary ms-2" id="exit-queue-logout" type="button">Sair</button>
        </div>
    </div>

    <p id="exit-queue-message" class="small" role="status" aria-live="polite"></p>
    <section id="exit-queue-list" class="d-none" aria-label="Saídas autorizadas">
        <div class="row g-2 align-items-end mb-3">
            <div class="col-sm-8 col-lg-6">
                <label class="form-label" for="exit-queue-code">Localizar por código</label>
                <input class="form-control" id="exit-queue-code" name="code" maxlength="80" autocomplete="off" placeholder="SAI-2026-0001" />
            </div>
            <div class="col-sm-4 col-lg-3 d-grid">
                <button class="btn btn-outline-primary" id="exit-queue-lookup" type="button">Identificar saída</button>
            </div>
            <div class="col-lg-3 d-grid">
                <button class="btn btn-outline-secondary" id="exit-queue-refresh" type="button">Atualizar fila</button>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mb-3">
            <button class="btn btn-outline-secondary btn-sm" id="exit-queue-camera-toggle" type="button">Abrir câmera para escanear QR</button>
            <label class="btn btn-outline-secondary btn-sm mb-0" for="exit-queue-qr-file">
                Ler QR por foto
                <input class="visually-hidden" id="exit-queue-qr-file" type="file" accept="image/*" />
            </label>
        </div>
        <p class="small text-secondary">A leitura é feita no navegador; a câmera exige HTTPS (ou localhost) e permissão do dispositivo.</p>
        <p class="small text-danger" id="exit-queue-camera-error" role="status" aria-live="polite"></p>
        <video class="w-100 rounded d-none mb-3" id="exit-queue-camera-video" muted playsinline autoplay style="max-width:480px;max-height:280px;object-fit:cover"></video>
        <canvas class="d-none" id="exit-queue-camera-canvas"></canvas>
        <div id="exit-queue-picked" class="mb-3"></div>
        <div id="exit-queue-results"></div>
    </section>
</section>

@section Scripts {
    <script src="~/lib/jsqr/jsQR.js" asp-append-version="true" defer></script>
    <script src="~/js/stock-exit-queue.js" asp-append-version="true" defer></script>
}
